# ==========================================================================
# KL ERP Backend - production environment
# Loaded by systemd via EnvironmentFile=/opt/kl-erp-backend/.env
# ==========================================================================

# ---- AWS credentials ------------------------------------------------------
# RECOMMENDED: attach an IAM instance role with API Gateway admin rights to
# the EC2 instance and leave these two COMMENTED OUT. boto3 will pick the
# role up automatically via the instance metadata service.
# (Do NOT set them to empty values - an empty AWS_ACCESS_KEY_ID breaks
# boto3's default credential chain.)
#AWS_ACCESS_KEY_ID=AKIA...
#AWS_SECRET_ACCESS_KEY=...

# Regions the API Gateway proxies are created in. India regions keep egress
# close to the ERP. Comma-separated, no spaces needed (they are stripped).
AWS_GATEWAY_REGIONS=ap-south-1,ap-south-2

# false = keep gateways on service stop (recommended: start() reuses them by
# name -> restarts take seconds, and idle gateways cost ~$0).
# true  = delete gateways from AWS on every clean shutdown.
DELETE_GATEWAYS_ON_SHUTDOWN=false

# ---- App ------------------------------------------------------------------
PORT=8000
WEB_CONCURRENCY=2
ERP_BASE_URL=https://newerp.kluniversity.in

# ---- Games leaderboard ----------------------------------------------------
# CHANGE THIS in production - it signs the anti-cheat game tokens.
GAME_JWT_SECRET=change-me-in-production-kl-games

# Leave empty to use the in-memory leaderboard fallback.
MONGODB_URI=

# Comma-separated student IDs allowed to hit /auto-feedback.
FEEDBACK_ALLOWED_USERS=2400032717

# ---- Campus Radio ---------------------------------------------------------
RADIO_JWT_SECRET=change-me-in-production-kl-radio
RADIO_REPORT_THRESHOLD=8
